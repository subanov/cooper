# Copy to .env and adjust. `.env` is git-ignored. Every variable is read once at start-up.

# --- Database ---------------------------------------------------------------
# Owner role: used by `cargo sqlx migrate run`, sqlx compile-time checks and tests.
DATABASE_URL=postgres://cooper:cooper@localhost:5432/cooper
# Application role used by cooper-server / cooper-worker. Not a superuser, so Row-Level
# Security applies. Falls back to DATABASE_URL when unset.
COOPER_DATABASE_URL=postgres://cooper_app:cooper_app@localhost:5432/cooper
COOPER_DATABASE_MAX_CONNECTIONS=10

# --- HTTP server (cooper-server) ---------------------------------------------
COOPER_BIND_ADDR=0.0.0.0:8080
# Comma-separated list of allowed CORS origins. Empty disables CORS.
COOPER_CORS_ALLOWED_ORIGINS=http://localhost:8080
COOPER_REQUEST_TIMEOUT_SECS=30
COOPER_BODY_LIMIT_BYTES=26214400

# --- Sign-in sessions (ADR-0011) -------------------------------------------------
# A session ends after this many minutes without a request...
COOPER_SESSION_IDLE_MINUTES=480
# ...and at the latest this many hours after sign-in.
COOPER_SESSION_MAX_HOURS=168
# Mark the session cookie Secure (HTTPS only). Set to false only for local plain HTTP.
COOPER_SECURE_COOKIES=false
# Reverse proxies whose X-Forwarded-For header is trusted (comma-separated IPs or CIDRs),
# so IP bans hit the real client. Leave empty when clients connect directly.
COOPER_TRUSTED_PROXIES=

# --- Encryption at rest (ADR-0013) ------------------------------------------------
# Required. Comma-separated <id>:<base64 32-byte key>, active key first. Generate a key
# with `openssl rand -base64 32`. To rotate, put a new key first and keep the old one
# until the re-encryption job has run (docs/runbooks/encryption-key-rotation.md).
# This development key is public: never use it in production.
COOPER_ENCRYPTION_KEYS=1:Y29vcGVyLWRldi1rZXktbmV2ZXItaW4tcHJvZC0wMDE=

# --- Attachments and email ------------------------------------------------------
# Where attachment content is stored (ADR-0007, ADR-0033): `filesystem` (default) or `s3`.
COOPER_BLOB_STORE=filesystem
# File system content (use a shared volume with several servers); with `s3`, uploads in
# progress are spooled under <dir>/tmp.
COOPER_BLOB_DIR=data/blobs
# S3-compatible bucket, used when COOPER_BLOB_STORE=s3. Objects stay private. Local
# SeaweedFS: `docker compose --profile s3 up -d s3`, endpoint http://localhost:8333,
# path-style, access key `cooper`, secret `cooper-secret` (create the bucket first).
COOPER_S3_ENDPOINT=
COOPER_S3_REGION=us-east-1
COOPER_S3_BUCKET=
COOPER_S3_ACCESS_KEY_ID=
COOPER_S3_SECRET_ACCESS_KEY=
# Optional key prefix inside the bucket, for example `cooper/`.
COOPER_S3_PREFIX=
# true for MinIO, SeaweedFS, Ceph and most self-hosted services.
COOPER_S3_PATH_STYLE=false
# Unreferenced content is deleted by the worker once older than this (worker).
COOPER_BLOB_ORPHAN_GRACE_HOURS=24
# The S3 integration test runs when this is set (for example http://localhost:8333).
COOPER_TEST_S3_ENDPOINT=

# --- Public address -----------------------------------------------------------------
# How browsers reach Cooper; OAuth redirect URIs (Mailbox Consent) are built from it.
# Empty: the general.base_url System Setting.
COOPER_PUBLIC_URL=
# Outbound email (worker). Unset: email stays queued. Mailpit locally:
COOPER_SMTP_URL=smtp://localhost:1025

# --- Worker (cooper-worker) ---------------------------------------------------
COOPER_WORKER_TICK_MILLIS=1000
COOPER_OUTBOX_BATCH_SIZE=100
COOPER_JOB_RUN_RETENTION_DAYS=30
# Days of warnings and errors kept for the system log viewer (FR-SYS-003).
COOPER_SYSTEM_LOG_RETENTION_DAYS=30

# --- Observability --------------------------------------------------------------
# `pretty` for local development, `json` for production log shipping.
COOPER_LOG_FORMAT=pretty
RUST_LOG=info,cooper=debug,sqlx=warn
# Serve Prometheus metrics on a separate, internal address (ADR-0023); empty disables.
COOPER_METRICS_ADDR=
# Export traces over OTLP/HTTP (for example http://localhost:4318); empty disables.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Suggested Replies (FR-AI-003, ADR-0037) ---------------------------------------
# A Gemini API key turns on "Suggest reply" in the ticket Composer; empty turns it off.
# Ticket text, including internal Notes, is sent to Google. Key from https://aistudio.google.com;
# on the free tier (no billing) Google may use prompts to improve its models, so use test
# data only there.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Comma-separated models tried in order when GEMINI_MODEL is overloaded (503/429) or does not answer.
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-flash-lite-latest
# Only for scripts/notebooks/gemini-playground.ipynb: a Cooper API Key (Administration -> API
# Keys) to try prompts on local tickets. The server does not read it.
COOPER_API_KEY=

# --- Local test services (docker compose) ---------------------------------------
POSTGRES_PORT=5432
# Tests and checks (`just test`, `just check`) use a separate PostgreSQL, not the compose
# one: container `cooper-test-postgres`, role/database `cooper_test` (scripts/test-db.sh).
COOPER_TEST_POSTGRES_PORT=55432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
GREENMAIL_SMTP_PORT=3025
GREENMAIL_IMAP_PORT=3143
GREENMAIL_IMAPS_PORT=3993
