  "query": "SELECT id, worker_id, started_at, finished_at, outcome, duration_ms, message\n         FROM background_job_runs\n         WHERE job_name = $1 AND ($2::timestamptz IS NULL OR (started_at, id) < ($2, $3))\n         ORDER BY started_at DESC, id DESC\n         LIMIT $4",
