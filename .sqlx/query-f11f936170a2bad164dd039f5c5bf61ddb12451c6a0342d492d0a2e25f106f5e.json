  "query": "\n        SELECT id, change_set_id, tenant_id, action, field, old_value, new_value,\n               actor_kind, actor_id, occurred_at\n        FROM audit_entries\n        WHERE aggregate_type = $1 AND aggregate_id = $2\n        ORDER BY occurred_at, id\n        ",
