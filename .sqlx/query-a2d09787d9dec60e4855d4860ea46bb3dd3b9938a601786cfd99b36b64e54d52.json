{
  "db_name": "PostgreSQL",
  "query": "SELECT id, recipient_id, tenant_id, kind, title, body, ticket_id, change_id, source_event_id, created_at, read_at\n             FROM notifications\n             WHERE recipient_id = $1 AND (NOT $2 OR read_at IS NULL)\n               AND ($3::timestamptz IS NULL OR (created_at, id) < ($3, $4))\n             ORDER BY created_at DESC, id DESC LIMIT $5",
