{
  "db_name": "PostgreSQL",
  "query": "SELECT id, tenant_id, full_name, email, username, phone, manager_id, cost_centre_id, department_id,\n                    deactivated_at, created_at, updated_at\n             FROM requesters\n             WHERE ($1 OR tenant_id = ANY($2))\n               AND ($3::uuid IS NULL OR tenant_id = $3)\n               AND ($4 OR is_active)\n               AND ($5::text IS NULL OR lower(full_name) LIKE $5 OR lower(email) LIKE $5 OR lower(username) LIKE $5)\n               AND ($6::text IS NULL OR (lower(full_name), id) > ($6, $7))\n               AND (cardinality($9::uuid[]) = 0 OR id = ANY($9))\n             ORDER BY lower(full_name), id\n             LIMIT $8",
