  "query": "SELECT t.id, t.name, t.description, t.team_ids, t.current_version, t.is_active, t.created_at, t.updated_at, v.content\n             FROM change_templates t JOIN change_template_versions v ON v.template_id = t.id AND v.version_no = t.current_version\n             ORDER BY lower(t.name)",
