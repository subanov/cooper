# Single-host deployment settings. Copy to .env (git-ignored) and fill in every value.
# Generate secrets with: openssl rand -base64 32

# Public host name; Caddy obtains its certificate from Let's Encrypt.
COOPER_DOMAIN=cooper.example.com
ACME_EMAIL=ops@example.com

# Image and version to run (see GitHub releases). Upgrade by changing the version.
COOPER_IMAGE=ghcr.io/subanov/cooper
COOPER_VERSION=0.1.0

# PostgreSQL: owner role `cooper` (migrations) and application role `cooper_app`.
POSTGRES_PASSWORD=
COOPER_APP_DB_PASSWORD=

# Encryption keys for secrets at rest (ADR-0013): `1:<base64 of 32 random bytes>`.
# Back this up separately from the database: backups are useless without it.
COOPER_ENCRYPTION_KEYS=

# Outbound email, for example smtp://user:pass@smtp.example.com:587
COOPER_SMTP_URL=

# Optional observability (ADR-0023): Prometheus metrics on the internal network
# (for example 0.0.0.0:9100) and OTLP/HTTP trace export.
COOPER_METRICS_ADDR=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Where scripts/backup.sh copies attachment files (absolute path on the host).
COOPER_BACKUP_DIR=/srv/cooper-backups
