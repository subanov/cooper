{
  "name": "cooper-web",
  "private": true,
  "version": "0.0.0",
  "description": "Cooper Analyst console and Self-Service Portal (ADR-0010).",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=12.18 <13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "scripts/playwright.sh e2e",
    "api:generate": "pnpm --filter @cooper/openapi-codegen exec openapi-typescript ../../openapi.json -o ../../src/api/schema.d.ts",
    "api:check": "pnpm --filter @cooper/openapi-codegen exec openapi-typescript ../../openapi.json -o ../../src/api/schema.d.ts --check",
    "check": "pnpm typecheck && pnpm lint && pnpm api:check && pnpm test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "visual": "scripts/playwright.sh visual",
    "visual:update": "scripts/playwright.sh visual --update-snapshots",
    "audit": "pnpm audit --audit-level high --prod"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.64.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intl": "^12.1.6",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
